[Unit]
Description=Spark Video Processor (ST 2110 pipeline daemon + NMOS node)
Documentation=https://github.com/moocowsheep/SparkVideoProcessor
Wants=network-online.target
After=network-online.target
# Timing first: the engine stamps RTP and paces TX off the CX-7 PHC, so bring PTP
# up before the pipeline. Wants= (not Requires=) — a PTP outage must not tear the
# media plane down, it just degrades genlock.
Wants=spark-ptp.service
After=spark-ptp.service
# mDNS/DNS-SD is how the node finds the registry (nmos_node.sh also pins it statically).
Wants=avahi-daemon.service
After=avahi-daemon.service

[Service]
Type=simple
# Root: DPDK on mlx5, hugepages, GPU clock locking.
EnvironmentFile=-@SPARK_ROOT@/deploy/lab.env
EnvironmentFile=-/etc/default/spark-video-processor
ExecStart=/bin/bash @SPARK_ROOT@/deploy/spark_run.sh
WorkingDirectory=@SPARK_ROOT@
Restart=on-failure
RestartSec=5
LimitMEMLOCK=infinity
LimitNOFILE=1048576
# The engine can take a while to unwind DPDK/EAL and the GPU context.
TimeoutStopSec=30
# spark_run.sh forwards SIGTERM to both children itself; the cgroup sweep afterwards
# catches the engine the daemon spawned.
KillMode=control-group

[Install]
WantedBy=multi-user.target
