#
# Site-local addressing for the deploy scripts. Copy to deploy/lab.env and fill in the values for
# YOUR plant; deploy/lab.env is gitignored and never committed.
#
#   cp deploy/lab.env.example deploy/lab.env && $EDITOR deploy/lab.env
#
# Everything checked into this repo — the SDPs, the scripts' defaults — uses the IETF documentation
# ranges instead of real addresses: 192.0.2.0/24 (RFC 5737 TEST-NET-1), 00:00:5e:00:53:xx (RFC 7042
# documentation MACs) and 00-00-5e-ff-fe-00-53-xx for EUI-64 PTP clock identities. Those are
# deliberately non-routable examples, so a checkout is inert until this file supplies real ones.
#
# The scripts source this file when present, so anything here overrides their defaults; a plain
# environment variable still wins over both.

# --- this box ---------------------------------------------------------------------------------
# HOST_ADDR   the address the NMOS node advertises (and its API binds for status checks)
# TX_ADDR     address on the EGRESS port (txPci). Resolves the sender SDP's source-filter — SSM
#             receivers drop every packet if it disagrees, while the sender still looks healthy.
# RX_ADDR     address on the INGRESS port (rxPci). Selects the port that joins the source group.
HOST_ADDR=192.0.2.103
TX_ADDR=192.0.2.110
RX_ADDR=192.0.2.103

# --- facility services ------------------------------------------------------------------------
REGISTRY_HOST=192.0.2.41
REGISTRY_PORT=8010

# --- PTP --------------------------------------------------------------------------------------
# Seed grandmaster identity (EUI-64, lower case, dash separated). The node re-reads the live GM
# from the daemon at runtime, so this only has to be plausible at launch.
GMID=00-00-5e-ff-fe-00-53-88
PTP_DOMAIN=127

# --- monitor / downstream receiver (IS-05 target for deploy/bd2_route_sr.sh) --------------------
# BD2_HOST  host:port of the receiving device's connection API
# BD2_RX    its video receiver id
BD2_HOST=192.0.2.195:8090
BD2_RX=00000000-0000-5000-8000-000000000001
